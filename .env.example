# Copy to .env and fill in. .env is git-ignored.

# First admin account for the command centre (created on first start if no admin exists).
# Use a password of 12+ characters; sign in at /#/command and create staff accounts from there.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Salt for hashing visitor IP addresses (rate limits, one vote per person). Any long random string.
IP_HASH_SALT=

# Behind a reverse proxy, how many hops to trust for the client address (e.g. 1).
# TRUST_PROXY=1

# Where the SQLite database and uploaded photos live (default: ./data).
# DATA_DIR=./data

# GISTDA API gateway key (fire hotspots and flooded areas from satellite). Free: https://api-gateway.gistda.or.th
# Used on the server only; never sent to browsers.
GISTDA_API_KEY=

# Web Push keys for alerts. Leave empty to have the server create them in data/vapid.json on first start.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.org

# น้องใจดี, the assistant (server/ai): Claude answers questions in any language, checks what the public sends
# (water reports and their photos, lost-and-found scams), triages and translates help requests, and drafts
# volunteer cards. Without a key the site still works: the chat answers in basic mode and checks use rules only.
# The key stays on the server.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5     # e.g. claude-sonnet-5-5 or claude-haiku-4-5 to spend less
# AI_DAILY_LIMIT=3000              # calls per day (Bangkok time) before falling back to basic mode
# AI_WEB_SEARCH=1                  # 0 turns off web search in the chat
# PORT=8787
